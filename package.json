{
  "name": "transcript-studio", "version": "0.1.0", "private": true,
  "description": "YouTube transcript desktop library", "author": "Transcript Studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1", "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "start": "electron .",
    "setup:python": "python -m venv .venv && node scripts/python.mjs install",
    "build:worker": "node scripts/python.mjs bundle",
    "test": "node --test tests/*.test.cjs && node scripts/python.mjs test",
    "dist": "pnpm build && pnpm build:worker && electron-builder"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "lucide-react": "^0.468.0" },
  "devDependencies": { "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.0.0", "vite": "^7.0.0", "typescript": "^5.9.0", "electron": "^42.0.0", "electron-builder": "^26.0.0", "concurrently": "^9.0.0", "wait-on": "^8.0.0" },
  "build": {
    "appId": "app.transcript.studio", "productName": "Transcript Studio",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [{ "from": "worker-dist", "to": "worker" }],
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
